# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Default RPC URL (Robinhood Chain Mainnet)
DEFAULT_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional: Additional RPC endpoints (comma-separated)
# ADDITIONAL_RPC_URLS=https://backup-rpc1.example.com,https://backup-rpc2.example.com

# Webhook secret token — Telegram sends this in X-Telegram-Bot-Api-Secret-Token
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=ice-cube-100

# Optional: Encryption key for session wallets (auto-generated if not set)
# SESSION_ENCRYPTION_KEY=your_32_byte_hex_key
